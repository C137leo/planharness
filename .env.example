# ============================================================
# 环境变量模板 —— 这个文件可以放心提交到 Git
# ------------------------------------------------------------
# 规则：本文件只放「占位符」和「本地开发默认值」，永远不放真实密钥。
#   · 本地开发：复制成 .env（.env 已被 .gitignore 忽略，不会进 Git）
#         cp .env.example .env
#   · 生产部署：写到服务器 /etc/planharness/planharness.env（640 root:planharness）
#         见 deploy/README.md §3.4
#   · 提交前自检：git diff --cached  —— 不应出现 sk- 开头的串或非 CHANGE_ME 的值
# ============================================================

# ---------- 本地开发默认值（不改也能跑） ----------
ENV=dev
# 零依赖：默认落本地 SQLite 文件，不需要装 Postgres
DATABASE_URL=sqlite:///./planharness.db
# 开发专用固定值，仅用于本地；生产必须换成随机串（见下方生产段）
SECRET_KEY=dev-only-change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- DeepSeek（留空 = 不调用 LLM，走模板兜底） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_S=30

# ============================================================
# 生产环境：以下值只写在服务器，不要填回本文件再提交
# ------------------------------------------------------------
# ENV=prod
# DATABASE_URL=postgresql+psycopg://appuser:<数据库密码>@127.0.0.1:5432/planharness
# SECRET_KEY=<随机串，见下>
# CORS_ORIGINS=https://www.agentworkout.online
# DEEPSEEK_API_KEY=<强烈建议走网关，见 docs/08-ai-gateway-security.md>
#
# 生成 SECRET_KEY（32 字节以上随机串）：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================

# ---------- 仅 docker-compose.example.yml 使用（当前生产不使用 Compose） ----------
# POSTGRES_PASSWORD=CHANGE_ME
