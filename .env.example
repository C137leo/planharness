# ============================================================
# 环境变量模板 —— 这个文件可以放心提交到 Git
# ------------------------------------------------------------
# 两套环境，两份配置，各管各的：
#
#   本地开发 / 测试   backend/.env                        ENV=dev   + SQLite
#   生产              /etc/planharness/planharness.env    ENV=prod  + Postgres
#
# 加载优先级：环境变量 > .env（按启动目录找）> 代码默认值
#   · 从 backend/ 启动  → 读 backend/.env
#   · 从仓库根启动      → 读 ./.env（不推荐，两份容易不一致）
#   · 临时覆盖不用改文件：
#       ENV=dev DATABASE_URL=sqlite:///./x.db uvicorn app.main:app
#
# 规则：本文件只放「占位符」和「本地开发默认值」，永远不放真实密钥。
#   · 本地：cp .env.example .env
#   · 生产：见 deploy/README.md §3.4
#   · 提交前自检：git diff --cached —— 不应出现 sk- 开头的串或非 CHANGE_ME 的值
# ============================================================

# ---------- 本地开发默认值（不改也能跑） ----------
ENV=dev
# 零依赖：默认落本地 SQLite 文件，不需要装 Postgres
DATABASE_URL=sqlite:///./planharness.db
# 开发专用固定值，仅用于本地；生产必须换成随机串（见下方生产段）
SECRET_KEY=dev-only-change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- LLM 成本控制（单次运行）----
# 超过任一上限：prompt 超限则不调用模型（省钱），用量超限则标记 budget_exceeded
# MAX_TOKENS_PER_RUN=20000
# MAX_COST_CNY_PER_RUN=0.05
# LLM_PRICE_IN_CNY_PER_MTOK=2.0
# LLM_PRICE_OUT_CNY_PER_MTOK=8.0

# ---------- LangGraph checkpointer ----------
# auto：DATABASE_URL 指向 Postgres 就用 Postgres，否则用内存（重启丢挂起审批）
# 可选：auto / memory / postgres
# CHECKPOINTER_BACKEND=auto
# 留空则直接用 DATABASE_URL；两者格式不同，代码会自动去掉 "+psycopg"
# CHECKPOINTER_DSN=
# CHECKPOINTER_POOL_SIZE=5
# 安全：限制 checkpoint 反序列化类型，避免「数据库被攻破 → 任意代码执行」
# LANGGRAPH_STRICT_MSGPACK=true

# ---------- DeepSeek（留空 = 不调用 LLM，走模板兜底） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_S=30

# ============================================================
# 生产环境：以下值只写在服务器，不要填回本文件再提交
# ------------------------------------------------------------
# ENV=prod
# DATABASE_URL=postgresql+psycopg://appuser:<数据库密码>@127.0.0.1:5432/planharness
# SECRET_KEY=<随机串，见下>
# CORS_ORIGINS=https://www.agentworkout.online
# DEEPSEEK_API_KEY=<强烈建议走网关，见 docs/08-ai-gateway-security.md>
#
# 生成 SECRET_KEY（32 字节以上随机串）：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================

# ---------- 仅 docker-compose.example.yml 使用（当前生产不使用 Compose） ----------
# POSTGRES_PASSWORD=CHANGE_ME
