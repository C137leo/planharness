# Copy to .env on the server; chmod 600. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
SECRET_KEY=change-me-to-a-32-byte-random-string

# 方案 B：Key 暂时放在服务器；低余额 + 演示后轮换。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_S=30
