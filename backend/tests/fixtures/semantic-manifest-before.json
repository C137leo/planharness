  {
    "capability_id": "profile.update",
    "domain": "profile",
    "description": "更新长期档案，必须确认。仅更新档案值，不会自动重算热量、食物份量或训练负荷。",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "goal": {
          "anyOf": [
            {
              "enum": [
                "fat_loss",
                "muscle_gain",
                "cardio",
                "health"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Goal"
        },
        "weight_kg": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 30,
              "le": 300
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Kg"
        },
        "weekly_days": {
          "anyOf": [
            {
              "maximum": 7,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weekly Days"
        },
        "session_minutes": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": 5,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Minutes"
        },
        "preferred_time_window": {
          "anyOf": [
            {
              "maxLength": 24,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Time Window"
        },
        "preferred_location": {
          "anyOf": [
            {
              "maxLength": 24,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Location"
        },
        "dislikes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dislikes"
        },
        "likes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Likes"
        },
        "allergies": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allergies"
        },
        "diet_preferences": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diet Preferences"
        }
      },
      "title": "ProfileArgs",
      "type": "object"
    },
    "target_types": [
      "profile"
    ],
    "mutates_state": true,
    "confirmation": "always",
    "constraints": "必须选择快照中属于本用户的真实 ID，执行范围仅为目标对象；版本必须一致。",
    "executor": "profile",
    "binding_schema": {
      "resolution.selected_id": {
        "role": "destination_or_existing_object",
        "types": [
          "profile"
        ]
