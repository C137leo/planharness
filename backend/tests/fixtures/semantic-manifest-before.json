              "type": "null"
            }
          ],
          "default": null,
          "title": "Sets Delta"
        },
        "reps_delta": {
          "anyOf": [
            {
              "maximum": 99,
              "minimum": -99,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reps Delta"
        }
      },
      "title": "ActionValues",
      "type": "object"
    },
    "target_types": [
      "workout_action",
      "session_item"
    ],
    "mutates_state": true,
    "confirmation": "uncertain",
    "constraints": "必须选择快照中属于本用户的真实 ID，执行范围仅为目标对象；版本必须一致。",
    "executor": "action",
    "binding_schema": {
      "resolution.selected_id": {
