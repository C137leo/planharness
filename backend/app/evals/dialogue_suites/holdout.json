  "conversations": [
    {
      "id": "holdout-colloquial-load",
      "turns": [
        {
          "text": "今天俯卧撑做三轮就收工，别的照原计划。",
          "expect": {
            "assertions": [
              {
                "path": "/days/2026-11-11/actions/push-up/sets",
                "value": 3
              }
            ],
            "allowed_changes": [
              "/days/2026-11-11/actions/push-up/sets"
            ],
            "reference_to_previous": false,
            "completion": true
          }
        },
        {
          "text": "方才说的那项再砍掉一轮。",
          "expect": {
            "assertions": [
              {
                "path": "/days/2026-11-11/actions/push-up/sets",
                "value": 2
              }
            ],
            "allowed_changes": [
              "/days/2026-11-11/actions/push-up/sets"
            ],
            "reference_to_previous": true,
            "completion": true
          }
        },
        {
          "text": "收回上一句，那个还是三组，其他别碰。",
          "expect": {
            "assertions": [
              {
                "path": "/days/2026-11-11/actions/push-up/sets",
                "value": 3
              }
            ],
            "allowed_changes": [
              "/days/2026-11-11/actions/push-up/sets"
            ],
            "reference_to_previous": true,
            "completion": true
          }
        }
      ]
    },
    {
      "id": "holdout-protein-reference",
      "turns": [
        {
          "text": "今晚那份鸡胸我想改吃牛肉，午餐别受影响。",
          "expect": {
