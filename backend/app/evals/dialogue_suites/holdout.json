              {
                "path": "/days/2026-11-11/actions/one-arm-dumbbell-row/sets",
                "value": 2
              }
            ],
            "allowed_changes": [
              "/days/2026-11-11/meals/dinner"
            ],
            "reference_to_previous": false,
            "completion": true
          }
        },
        {
          "text": "回到之前改过的训练动作，它再多做一组，其余维持。",
          "expect": {
            "assertions": [
              {
                "path": "/days/2026-11-11/actions/one-arm-dumbbell-row/sets",
                "value": 3
              }
            ],
            "allowed_changes": [
              "/days/2026-11-11/actions/one-arm-dumbbell-row/sets"
            ],
            "reference_to_previous": true,
            "completion": true
          }
        }
      ]
