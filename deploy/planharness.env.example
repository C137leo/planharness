# ============================================================
# 生产环境变量模板（给 systemd 的 EnvironmentFile 用）
# ------------------------------------------------------------
# 用法（服务器上，root）：
#     sudo install -m 640 -o root -g planharness /dev/null /etc/planharness/planharness.env
#     sudo nano /etc/planharness/planharness.env        # 把 CHANGE_ME_* 全部替换掉
#
# 铁律：
#   1) 这个文件只存在于服务器 /etc/planharness/，**不要放进代码仓库**；
#   2) 权限 640，属主 root:planharness；
#   3) 所有 CHANGE_ME_* 必须替换，deploy/preflight.sh 会把它们判为阻断；
#   4) 仓库里的 .env 只给本地开发用（ENV=dev + SQLite），两者不要混。
#
# 注意：值里不要用 < > 空格 ` $ 这些字符 —— systemd 能读，
# 但 shell 脚本（如 preflight.sh）按 bash 语法解析时会当成重定向而失败。
# ============================================================

ENV=prod

# 密码含 @ : / ? # 时必须 URL 编码，例如 my@pass → my%40pass
DATABASE_URL=postgresql+psycopg://appuser:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/planharness

# 32 字节以上随机串：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_SECRET_KEY

CORS_ORIGINS=https://www.agentworkout.online

# ---- DeepSeek（留空 = 不调用模型，走模板兜底）----
# 生产推荐：Key 只放 640 的 credentials 文件，这里只写路径
# DEEPSEEK_API_KEY_FILE=/etc/planharness/deepseek.key
# 兼容旧方式（开发/临时）：直接填 Key；两者同时存在时 API_KEY 优先
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
# 只有这个手机号能在 Console 暂停/恢复大模型调用
LLM_ADMIN_PHONE=13772692821
DEEPSEEK_TIMEOUT_S=60
# flash 的思考档位：low/high/max，留空=服务端默认(high)；规划用 low 快一倍
DEEPSEEK_REASONING_EFFORT=low

# ---- LLM 成本控制（单次运行）----
# 超过任一上限：prompt 超限则不调用模型（省钱），用量超限则标记 budget_exceeded
# MAX_TOKENS_PER_RUN=20000
# MAX_COST_CNY_PER_RUN=0.05
# LLM_PRICE_IN_CNY_PER_MTOK=2.0
# LLM_PRICE_OUT_CNY_PER_MTOK=8.0

# ---- healthy-fitness-coach skill（Node 确定性引擎，可选但建议）----
# 容器/服务器上 skill 的绝对路径；为空则所有计划走本地兜底（能跑，但没有 skill 的编排）
# 生成方式见 deploy/vendor-skill.sh，产物在 backend/vendor/healthy-fitness-coach-skill
SKILL_DIR=/srv/planharness/vendor/healthy-fitness-coach-skill
# node 可执行文件；不填会在 PATH 里找，再试 /usr/local/bin、/opt/homebrew/bin
SKILL_NODE=
# 单次 skill 调用超时（秒）；subprocess 启动约 60ms，正常请求远低于 2s
SKILL_TIMEOUT=20

# ---- 上下文预算与 checkpointer ----
CONTEXT_TOKEN_BUDGET=2000
CHECKPOINTER_BACKEND=auto
CHECKPOINTER_POOL_SIZE=5
# 限制 checkpoint 反序列化类型，防止数据库被攻破后被拿来执行代码
LANGGRAPH_STRICT_MSGPACK=true

# ---- 麦当劳 MCP（可选）：留空则不启用，工具不会暴露给模型 ----
# 控制台拿到的地址与 token 只放这里，不要写进代码或提交到 git
MCD_MCP_URL=https://mcp.mcd.cn
# Token 获取：https://open.mcd.cn/mcp （手机号登录 → 控制台 → 激活 → 复制）
# 服务端内置 token；真实值只放 .env / EnvironmentFile，不提交 Git。
MCD_MCP_TOKEN=
# 可选私有口令：设置后，用户输入该口令时使用上面的服务端 token；
# 留空则只认用户自己的 token。不要把真实口令提交 Git。
MCD_MCP_TOKEN_ALIAS=
MCD_MCP_TOOL=list-nutrition-foods
MCD_MCP_TIMEOUT=15
# 1 = 允许"帮你点好（到付款前）"（会真的生成待支付订单）；0 = 只读营养库
MCD_MCP_ALLOW_ORDER=1
