# ============================================================
# 生产环境变量模板（给 systemd 的 EnvironmentFile 用）
# ------------------------------------------------------------
# 用法（服务器上，root）：
#     sudo install -m 640 -o root -g planharness /dev/null /etc/planharness/planharness.env
#     sudo nano /etc/planharness/planharness.env        # 把 CHANGE_ME_* 全部替换掉
#
# 铁律：
#   1) 这个文件只存在于服务器 /etc/planharness/，**不要放进代码仓库**；
#   2) 权限 640，属主 root:planharness；
#   3) 所有 CHANGE_ME_* 必须替换，deploy/preflight.sh 会把它们判为阻断；
#   4) 仓库里的 .env 只给本地开发用（ENV=dev + SQLite），两者不要混。
#
# 注意：值里不要用 < > 空格 ` $ 这些字符 —— systemd 能读，
# 但 shell 脚本（如 preflight.sh）按 bash 语法解析时会当成重定向而失败。
# ============================================================

ENV=prod

# 密码含 @ : / ? # 时必须 URL 编码，例如 my@pass → my%40pass
DATABASE_URL=postgresql+psycopg://appuser:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/planharness

# 32 字节以上随机串：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_SECRET_KEY

CORS_ORIGINS=https://www.agentworkout.online

# ---- DeepSeek（留空 = 不调用模型，走模板兜底）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_S=30

# ---- LLM 成本控制（单次运行）----
# 超过任一上限：prompt 超限则不调用模型（省钱），用量超限则标记 budget_exceeded
# MAX_TOKENS_PER_RUN=20000
# MAX_COST_CNY_PER_RUN=0.05
# LLM_PRICE_IN_CNY_PER_MTOK=2.0
# LLM_PRICE_OUT_CNY_PER_MTOK=8.0

# ---- 上下文预算与 checkpointer ----
CONTEXT_TOKEN_BUDGET=2000
CHECKPOINTER_BACKEND=auto
CHECKPOINTER_POOL_SIZE=5
# 限制 checkpoint 反序列化类型，防止数据库被攻破后被拿来执行代码
LANGGRAPH_STRICT_MSGPACK=true
