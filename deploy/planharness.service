[Unit]
Description=PlanHarness API (FastAPI + uvicorn)
After=network-online.target docker.service
Wants=network-online.target
# Postgres runs as a Docker container; if Docker restarts, API should come back.
After=docker.service

[Service]
Type=simple
User=planharness
Group=planharness
WorkingDirectory=/opt/planharness/backend
EnvironmentFile=/etc/planharness/planharness.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

# Wait for the local Postgres port before starting the app.
ExecStartPre=/bin/bash -c 'for i in {1..30}; do (echo > /dev/tcp/127.0.0.1/5432) >/dev/null 2>&1 && exit 0; sleep 2; done; exit 1'

ExecStart=/opt/planharness/backend/.venv/bin/uvicorn app.main:app \
  --host 127.0.0.1 \
  --port 9200 \
  --workers 1 \
  --proxy-headers \
  --forwarded-allow-ips=127.0.0.1 \
  --limit-concurrency 20

Restart=always
RestartSec=3
TimeoutStopSec=20

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# --- 进一步加固（Ubuntu 24.04 / systemd 255 支持） ---
PrivateDevices=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# 让本服务看不到其它进程的 /proc/<pid>，降低「环境变量里带密钥」时的暴露面
ProtectProc=invisible
ProcSubset=pid

# 系统调用白名单：更严，但个别依赖可能不兼容。
# 如果启动失败且日志里出现 SECCOMP / status=2xx，先注释掉这两行再排查。
# SystemCallFilter=@system-service
# SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
